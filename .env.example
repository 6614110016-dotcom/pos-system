APP_NAME="ระบบขายหน้าร้าน POS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Bangkok
APP_URL=http://localhost:8000

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=th_TH

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pos_system
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="pos@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ข้อมูลร้านที่จะแสดงบนใบเสร็จ
SHOP_NAME="ร้านสะดวกซื้อ KAN MART"
SHOP_ADDRESS="123 ถ.มหาวิทยาลัย ต.ในเมือง อ.เมือง จ.ขอนแก่น 40000"
SHOP_PHONE="043-000-000"
SHOP_TAX_ID="0000000000000"
SHOP_VAT_RATE=7
